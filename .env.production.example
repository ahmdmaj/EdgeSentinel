# ==========================================
# EdgeSentinel Production Environment Template
# ==========================================
# WARNING: DO NOT commit your actual .env.production file to version control.
# Copy this file to .env.production and fill in the values before deploying.

# ------------------------------------------
# MySQL Configuration
# ------------------------------------------
# Generate a strong, random password (e.g., `openssl rand -base64 32`)
MYSQL_USER=edgesentinel_admin
MYSQL_PASSWORD=<REPLACE_WITH_STRONG_PASSWORD>
MYSQL_DATABASE=edgesentinel
MYSQL_PORT=3306

# Database Connection (must match the credentials above)
# Format: mysql://USER:PASSWORD@mysql:3306/DATABASE
DATABASE_URL=mysql://edgesentinel_admin:<REPLACE_WITH_STRONG_PASSWORD>@mysql:3306/edgesentinel

# ------------------------------------------
# MQTT Configuration
# ------------------------------------------
MQTT_PORT=1883
MQTT_BROKER_URL=mqtt://mosquitto:1883
MQTT_USERNAME=edge_client
# Generate a strong password. You MUST also update mosquitto.passwd!
MQTT_PASSWORD=<REPLACE_WITH_STRONG_PASSWORD>

# ------------------------------------------
# Security & Secrets
# ------------------------------------------
# JWT Secret Key (Generate a random 64-character hex string)
JWT_SECRET=<REPLACE_WITH_LONG_RANDOM_SECRET>

# Edge Control Plane Token (Generate a random secure string)
EDGE_ADMIN_TOKEN=<REPLACE_WITH_STRONG_TOKEN>

# ------------------------------------------
# Initial Admin Seed Credentials
# ------------------------------------------
# These will be used to create the first admin user on startup.
SEED_ADMIN_EMAIL=admin@edgesentinel.local
SEED_ADMIN_PASSWORD=<REPLACE_WITH_STRONG_PASSWORD>
API_EMAIL=admin@edgesentinel.local
API_PASSWORD=<REPLACE_WITH_STRONG_PASSWORD>
